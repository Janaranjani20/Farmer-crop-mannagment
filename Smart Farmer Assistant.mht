<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-abc14018-88d6-4192-b841-f405a5aa8f0c@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Farmer Assistant</title>


</head>

<body>

<header>
    <h1>🌱 Smart Farmer Assistant</h1>
    <p>Smart Technology for Better Farming</p>
</header>

<nav>
    <button>Farmer Login</button>
    <button>Crop Recommendation</button>
    <button>Irrigation</button>
    <button>Profit Calculator</button>
    <button>Disease Detection</button>
    <button>Dashboard</button>
</nav>

<div class="container">

<!-- LOGIN -->
<section id="login" class="card">
    <h2>👨‍🌾 Farmer Login</h2>

    <input type="text" id="farmerName" placeholder="Enter Farmer Name">

    <input type="text" id="location" placeholder="Enter Location">

    <select id="soil">
        <option value="">Select Soil Type</option>
        <option value="black">Black Soil</option>
        <option value="red">Red Soil</option>
        <option value="alluvial">Alluvial Soil</option>
        <option value="sandy">Sandy Soil</option>
    </select>

    <select id="water">
        <option value="">Water Availability</option>
        <option value="high">High</option>
        <option value="medium">Medium</option>
        <option value="low">Low</option>
    </select>

    <button class="main-btn">Save Farmer Details</button>

    <div id="loginResult"></div>
</section>

<!-- CROP -->
<section id="crop" class="card hidden">
    <h2>🌾 Smart Crop Recommendation</h2>

    <p>Enter your soil and water details to get a crop suggestion.</p>

    <select id="cropSoil">
        <option value="">Select Soil</option>
        <option value="black">Black Soil</option>
        <option value="red">Red Soil</option>
        <option value="alluvial">Alluvial Soil</option>
        <option value="sandy">Sandy Soil</option>
    </select>

    <select id="cropWater">
        <option value="">Select Water Availability</option>
        <option value="high">High</option>
        <option value="medium">Medium</option>
        <option value="low">Low</option>
    </select>

    <button class="main-btn">Recommend Crop</button>

    <div id="cropResult"></div>
</section>

<!-- IRRIGATION -->
<section id="water" class="card hidden">
    <h2>💧 Smart Irrigation Suggestion</h2>

    <select id="weather">
        <option value="">Today's Weather</option>
        <option value="sunny">Sunny</option>
        <option value="cloudy">Cloudy</option>
        <option value="rainy">Rainy</option>
    </select>

    <select id="soilMoisture">
        <option value="">Soil Moisture</option>
        <option value="dry">Dry</option>
        <option value="normal">Normal</option>
        <option value="wet">Wet</option>
    </select>

    <button class="main-btn">Get Suggestion</button>

    <div id="waterResult"></div>
</section>

<!-- PROFIT -->
<section id="profit" class="card hidden">
    <h2>💰 Farm Profit Calculator</h2>

    <input type="number" id="seedCost" placeholder="Seed Cost ₹">

    <input type="number" id="fertilizerCost" placeholder="Fertilizer Cost ₹">

    <input type="number" id="labourCost" placeholder="Labour Cost ₹">

    <input type="number" id="otherCost" placeholder="Other Cost ₹">

    <input type="number" id="income" placeholder="Expected Income ₹">

    <button class="main-btn">Calculate Profit</button>

    <div id="profitResult"></div>
</section>

<!-- DISEASE -->
<section id="disease" class="card hidden">
    <h2>🐛 Crop Disease Detection</h2>

    <p>Upload a crop leaf image for a basic demo.</p>

    <input type="file" accept="image/*" id="leafImage">

    <button class="main-btn">Check Crop</button>

    <div id="diseaseResult"></div>
</section>

<!-- DASHBOARD -->
<section id="dashboard" class="card hidden">
    <h2>📊 Farmer Dashboard</h2>

    <div id="dashboardContent">
        <p>Login and save your farmer details to see your dashboard.</p>
    </div>

    <h3 style="margin-top:20px;">🔔 Alerts</h3>

    <div class="alert">🌧️ Check weather before irrigation.</div>
    <div class="alert">🐛 Monitor crops regularly for pests.</div>
    <div class="alert">🌱 Keep fertilizer usage according to crop requirements.</div>
</section>

</div>






  
    
