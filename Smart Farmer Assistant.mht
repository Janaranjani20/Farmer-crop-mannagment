@charset "utf-8";

* { box-sizing: border-box; margin: 0px; padding: 0px; font-family: Arial, sans-serif; }

body { background: rgb(241, 248, 243); color: rgb(27, 67, 50); }

header { background: rgb(45, 106, 79); color: white; padding: 20px; text-align: center; }

nav { background: rgb(27, 67, 50); padding: 12px; text-align: center; }

nav button { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: white; margin: 5px 10px; cursor: pointer; font-size: 15px; }

.container { max-width: 900px; margin: 25px auto; padding: 15px; }

.card { background: white; padding: 25px; margin-bottom: 20px; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 10px; }

h2 { margin-bottom: 15px; }

input, select { width: 100%; padding: 12px; margin: 8px 0px 15px; border: 1px solid rgb(204, 204, 204); border-radius: 7px; }

.main-btn { background: rgb(45, 106, 79); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 12px 20px; border-radius: 7px; cursor: pointer; }

.main-btn:hover { background: rgb(27, 67, 50); }

.result { margin-top: 15px; padding: 15px; background: rgb(216, 243, 220); border-radius: 8px; }

.hidden { display: none; }

.alert { padding: 12px; background: rgb(255, 243, 205); border-radius: 8px; margin: 8px 0px; }
